* {
  box-sizing: border-box;
}

:root {
  font-family: 'Inter', sans-serif;
  color: #f8fafc;
  background: #040814;
  line-height: 1.5;
  font-weight: 400;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(59, 130, 246, 0.12), transparent 35%),
    radial-gradient(circle at 80% 20%, rgba(168, 85, 247, 0.16), transparent 25%),
    #040814;
  color: #e2e8f0;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
  border: none;
}

#root {
  min-height: 100vh;
}

.app-shell {
  width: min(1440px, calc(100% - 32px));
  margin: 0 auto;
  padding: 24px 0 64px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 18px 22px;
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 22px;
  backdrop-filter: blur(16px);
  position: sticky;
  top: 16px;
  z-index: 20;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  font-weight: 900;
  font-size: 1.3rem;
  color: #020617;
  background: linear-gradient(135deg, #67e8f9, #a78bfa);
  box-shadow: 0 14px 28px rgba(103, 232, 249, 0.25);
}

.brand-name {
  margin: 0;
  font-weight: 800;
  letter-spacing: 0.02em;
}

.brand-tag {
  display: block;
  color: #94a3b8;
  font-size: 0.74rem;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 28px;
  color: #cbd5e1;
}

.main-nav a {
  transition: color 0.2s ease;
}

.main-nav a:hover {
  color: #fff;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 18px;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 10px;
  width: min(390px, 34vw);
  padding: 12px 14px;
  border-radius: 14px;
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid rgba(148, 163, 184, 0.18);
}

.search-box input {
  flex: 1;
  background: transparent;
  border: none;
  color: #f8fafc;
  outline: none;
}

.search-box input::placeholder {
  color: #94a3b8;
}

.primary-btn,
.ghost-btn,
.chip,
.tab,
.heart-btn,
.close-btn {
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.primary-btn:hover,
.ghost-btn:hover,
.chip:hover,
.tab:hover,
.heart-btn:hover,
.close-btn:hover {
  transform: translateY(-1px);
}

.primary-btn {
  background: linear-gradient(135deg, #7c3aed, #22d3ee);
  padding: 12px 18px;
  border-radius: 12px;
  color: white;
  font-weight: 700;
  box-shadow: 0 14px 22px rgba(124, 58, 237, 0.25);
}

.primary-btn.small {
  padding: 9px 12px;
  font-size: 0.8rem;
}

.ghost-btn {
  background: rgba(15, 23, 42, 0.7);
  color: #e2e8f0;
  border: 1px solid rgba(148, 163, 184, 0.2);
  padding: 12px 16px;
  border-radius: 12px;
  font-weight: 600;
}

.ghost-btn.small {
  padding: 9px 12px;
  font-size: 0.8rem;
}

.page-content {
  margin-top: 28px;
}

.hero-section {
  min-height: 500px;
  display: grid;
  grid-template-columns: 1.7fr 0.8fr;
  align-items: end;
  padding: 42px;
  border-radius: 30px;
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(148, 163, 184, 0.18);
}

.hero-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(2, 6, 23, 0.8), rgba(2, 6, 23, 0.2));
}

.hero-copy,
.hero-panel {
  position: relative;
  z-index: 1;
}

.hero-copy {
  max-width: 680px;
}

.pill {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(103, 232, 249, 0.35);
  padding: 7px 12px;
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.hero-copy h1 {
  margin: 20px 0 14px;
  font-size: clamp(2.8rem, 5vw, 5.2rem);
  line-height: 0.94;
  letter-spacing: -0.06em;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 15px;
  color: rgba(255, 255, 255, 0.86);
  font-weight: 600;
}

.hero-copy p {
  max-width: 620px;
  margin: 18px 0 24px;
  color: rgba(226, 232, 240, 0.9);
  font-size: 1.04rem;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-bottom: 18px;
}

.cast-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  color: rgba(255, 255, 255, 0.85);
}

.cast-list li {
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.hero-panel {
  display: grid;
  gap: 18px;
  justify-self: end;
  width: min(100%, 260px);
}

.stat-card {
  padding: 20px 18px;
  border-radius: 20px;
  background: rgba(15, 23, 42, 0.72);
  border: 1px solid rgba(148, 163, 184, 0.18);
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.stat-card span {
  color: #cbd5e1;
  font-size: 0.85rem;
}

.stat-card strong {
  font-size: 1.7rem;
}

.stats-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
  margin-top: 22px;
}

.mini-stat {
  padding: 20px 22px;
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mini-stat span {
  color: #94a3b8;
}

.mini-stat strong {
  font-size: 1.7rem;
}

.discover-section {
  margin-top: 36px;
}

.section-header {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 20px;
}

.section-header.small-gap {
  margin-bottom: 18px;
}

.section-kicker {
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.72rem;
  color: #7dd3fc;
  margin: 0 0 8px;
}

.section-header h2,
.panel-header h3,
.profile-card h3 {
  margin: 0;
  font-size: clamp(1.7rem, 2vw, 2.4rem);
}

.genre-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.chip {
  background: rgba(15, 23, 42, 0.7);
  color: #dfe8f5;
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 999px;
  padding: 9px 14px;
  font-weight: 600;
}

.chip.active {
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.8), rgba(168, 85, 247, 0.8));
  border-color: transparent;
}

.tab-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 26px;
}

.tab {
  background: rgba(15, 23, 42, 0.7);
  color: #cbd5e1;
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 12px;
  padding: 10px 14px;
  font-weight: 600;
}

.tab.active {
  background: rgba(96, 165, 250, 0.18);
  color: #eff6ff;
  border-color: rgba(96, 165, 250, 0.5);
}

.movie-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 22px;
}

.movie-card {
  overflow: hidden;
  background: rgba(15, 23, 42, 0.78);
  border: 1px solid rgba(148, 163, 184, 0.14);
  border-radius: 22px;
}

.poster {
  height: 320px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-bottom: 1px solid rgba(148, 163, 184, 0.15);
}

.poster-topbar,
.poster-bottom,
.movie-meta,
.review-head,
.recommend-meta,
.modal-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.mini-tag {
  display: inline-flex;
  background: rgba(15, 23, 42, 0.72);
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 0.66rem;
  font-weight: 700;
}

.heart-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.7);
  color: #fff;
  font-size: 1.2rem;
}

.poster-bottom {
  color: #f8fafc;
  font-weight: 600;
}

.movie-body {
  padding: 18px 16px 20px;
}

.movie-info-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.movie-info-head h3 {
  margin: 0;
  font-size: 1.2rem;
}

.movie-info-head span {
  color: #a5b4cf;
  font-size: 0.85rem;
}

.movie-body p {
  margin: 12px 0 14px;
  color: #cbd5e1;
  font-size: 0.92rem;
}

.movie-meta {
  color: #94a3b8;
  font-size: 0.8rem;
}

.card-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 18px;
}

.empty-state {
  display: grid;
  place-items: center;
  min-height: 180px;
  grid-column: 1 / -1;
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(148, 163, 184, 0.14);
  border-radius: 22px;
  color: #e2e8f0;
}

.bottom-grid {
  margin-top: 36px;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr 1.2fr;
  gap: 22px;
}

.panel {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 22px;
  padding: 22px;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.trend-list,
.review-list,
.stack-list {
  display: grid;
  gap: 14px;
}

.trend-item {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 14px;
  padding: 12px;
  background: rgba(2, 6, 23, 0.2);
  border-radius: 14px;
  border: 1px solid rgba(148, 163, 184, 0.08);
}

.trend-rank {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.3), rgba(168, 85, 247, 0.2));
  font-weight: 800;
}

.trend-copy {
  display: flex;
  flex-direction: column;
}

.trend-copy span,
.muted,
.review-item p,
.stack-card p,
.recommend-copy p,
.profile-stats span {
  color: #b7c3d8;
}

.trend-score {
  color: #7dd3fc;
  font-weight: 700;
}

.stack-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 12px 10px;
  border-radius: 14px;
  background: rgba(2, 6, 23, 0.2);
  border: 1px solid rgba(148, 163, 184, 0.08);
}

.stack-color {
  width: 12px;
  height: 42px;
  border-radius: 999px;
}

.stack-card strong,
.review-head strong,
.recommend-copy h4 {
  display: block;
  margin-bottom: 3px;
}

.review-item {
  padding: 14px 12px;
  border-radius: 14px;
  background: rgba(2, 6, 23, 0.2);
  border: 1px solid rgba(148, 163, 184, 0.08);
}

.review-head {
  margin-bottom: 8px;
}

.review-head span {
  color: #fbbf24;
}

.recommendation-section {
  margin-top: 36px;
}

.recommendation-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.recommend-card {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 18px;
  overflow: hidden;
}

.recommend-poster {
  height: 180px;
}

.recommend-copy {
  padding: 16px;
}

.recommend-copy h4 {
  margin: 0 0 5px;
  font-size: 1.1rem;
}

.recommend-meta {
  margin-top: 12px;
}

.recommend-meta button {
  background: rgba(96, 165, 250, 0.12);
  color: #e0f2fe;
  border: 1px solid rgba(125, 211, 252, 0.32);
  padding: 8px 12px;
  border-radius: 10px;
}

.profile-section {
  margin-top: 36px;
  display: grid;
  grid-template-columns: 1fr 1.3fr;
  gap: 18px;
}

.profile-card,
.profile-stats {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 20px;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 24px;
}

.avatar {
  width: 64px;
  height: 64px;
  display: grid;
  place-items: center;
  font-weight: 900;
  border-radius: 50%;
  background: linear-gradient(135deg, #38bdf8, #a78bfa);
  color: #020617;
}

.profile-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  padding: 18px 24px;
}

.profile-stats div {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.profile-stats strong {
  font-size: 1.2rem;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(2, 6, 23, 0.8);
  display: grid;
  place-items: center;
  padding: 24px;
  z-index: 50;
}

.modal-card {
  position: relative;
  width: min(900px, 100%);
  background: #0f172a;
  border-radius: 24px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  overflow: hidden;
}

.close-btn {
  position: absolute;
  top: 16px;
  right: 16px;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.7);
  color: white;
  z-index: 2;
}

.trailer-screen {
  height: 420px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, rgba(59,130,246,0.35), rgba(168,85,247,0.24)),
    radial-gradient(circle at 30% 30%, rgba(34, 211, 238, 0.5), transparent 24%);
}

.play-circle {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.2);
  display: grid;
  place-items: center;
  font-size: 2.4rem;
  color: white;
}

.modal-copy {
  padding: 22px 24px 28px;
}

.modal-copy h3 {
  margin: 14px 0 10px;
  font-size: clamp(1.9rem, 2vw, 2.5rem);
}

.modal-copy p {
  margin: 0 0 16px;
  color: #dbe3f1;
}

@media (max-width: 1100px) {
  .movie-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .bottom-grid,
  .recommendation-grid,
  .profile-section {
    grid-template-columns: 1fr;
  }

  .topbar {
    flex-wrap: wrap;
  }

  .main-nav {
    order: 3;
    width: 100%;
    justify-content: center;
  }

  .search-box {
    width: min(100%, 420px);
  }
}

@media (max-width: 700px) {
  .app-shell {
    width: min(100% - 20px, 1440px);
    padding-top: 14px;
  }

  .hero-section {
    grid-template-columns: 1fr;
    padding: 28px 20px 26px;
  }

  .hero-panel {
    width: 100%;
    justify-self: stretch;
    margin-top: 20px;
  }

  .stats-strip,
  .movie-grid,
  .recommendation-grid,
  .profile-stats {
    grid-template-columns: 1fr;
  }

  .section-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .topbar-actions {
    width: 100%;
    justify-content: space-between;
  }

  .search-box {
    width: 100%;
  }

  .hero-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .card-actions {
    flex-direction: column;
    align-items: stretch;
  }
}
